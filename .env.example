# ========================================
# MedVoice - Environment Variables (Backend)
# ========================================
# Secrets and service configuration.
# Runtime defaults for other settings are in config.yaml

# ========== REQUIRED ==========
# Hugging Face token for pyannote speaker diarization models
# Create one at: https://huggingface.co/settings/tokens
# Must accept user agreements for:
#   - https://huggingface.co/pyannote/speaker-diarization-3.1
#   - https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=your_huggingface_token_here

# PostgreSQL connection (must match POSTGRES_URL in frontend/.env)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/medvoice_portal

# Shared authentication secret (must match AUTH_SECRET in frontend/.env)
# Generate with: openssl rand -hex 32
AUTH_SECRET=your-secret-key-here

# ========== LM STUDIO (Medical RAG) ==========
# LM Studio server for medical processing 
# If running in Docker:
# LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
# If running locally:
LM_STUDIO_BASE_URL=http://localhost:1234/v1

LM_STUDIO_MODEL=gemma2-9b-it-psy10k-mental_health-i1
LM_STUDIO_MAX_TOKENS=8192

EMBEDDING_MODEL=text-embedding-bge-reranker-v2-m3
EMBEDDING_DIMENSION=1024

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Ho_Chi_Minh

# Hardware configuration
DEVICE=cpu                # cpu (Mac and non-GPU), cuda
COMPUTE_TYPE=int8         # int8 (Mac and non-GPU), float16, float32

# ========== OPTIONAL ==========
# Pre-downloaded diarization model path (speeds up first run)
# DIARIZATION_MODEL_PATH=/path/to/pyannote/model

# HIPAA encryption key (the application uses 'default' when unset; do NOT use 'default' in production)
# Generate a secure key for production: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# HIPAA_ENCRYPTION_KEY=your_encryption_key_here

# pgweb PostgreSQL dashboard port (default: 8081)
# Start with: docker compose -f docker-compose.pgweb.yaml up -d
# PGWEB_PORT=8081