# Environment configuration for MedVoice Clinical Portal
# Copy to .env and fill in values. Run `pnpm db:setup` to initialize.

# Database connection (Postgres)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/medvoice_portal

# Application settings
BASE_URL=http://localhost:3000
AUTH_SECRET=your-secret-key-here

# MedVoice FastAPI backend URL (used by API proxy routes)
BACKEND_URL=http://localhost:8000