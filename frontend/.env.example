# This file is generated by `npm run db:setup`.

# Database connection (must match POSTGRES_URL in root .env)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/medvoice_portal

# Shared authentication secret (must match AUTH_SECRET in root .env)
AUTH_SECRET=your-secret-key-here

# Application settings
BASE_URL=http://localhost:3000

# MedVoice FastAPI backend URL (used by API proxy routes)
BACKEND_URL=http://localhost:8000
